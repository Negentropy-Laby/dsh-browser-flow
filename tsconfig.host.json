{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "lib/host",
    "declaration": true,
    "composite": true,
    "tsBuildInfoFile": ".cache/host.tsbuildinfo"
  },
  "include": [
    "src/**/*.js",
    "src/**/*.ts"
  ],
  "exclude": [
    "src/client.ts",
    "src/clientcore.ts",
    "src/panel.ts",
    "src/page/runtime.ts",
    "src/page/operations.ts",
    "src/page/policy.ts",
    "src/page/import.ts",
    "src/client-wire.ts"
  ]
}
